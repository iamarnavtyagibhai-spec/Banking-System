# ==========================================
# NinjaBank User Service Configuration Template
# ==========================================

SERVER_PORT=8081

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://your-host:5432/ninjabank_user_db?sslmode=require
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=your_password

# JWT Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security
JWT_EXPIRATION=86400000

# Brevo (Sendinblue) Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@domain.com
BREVO_SENDER_NAME=NinjaBank
